rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Cada casa tiene un código secreto largo (va en el enlace de invitación).
    // Solo quien conoce el código puede leer y escribir su lista.
    match /casas/{casa}/{coleccion}/{doc} {
      allow read, write: if request.auth != null
        && casa.size() >= 16
        && coleccion in ['items', 'products', 'stock', 'trips', 'config'];
    }
  }
}
